/* Rofi minimalista — Gruvbox Mint (combina com o teu i3 config) */

* {
    bg:       #282828;
    bg-alt:   #32302f;
    fg:       #ebdbb2;
    fg-dim:   #a89984;
    accent:   #689d6a;
    accent2:  #b8bb26;

    background-color: transparent;
    text-color:        @fg;
    font:               "JetBrainsMono Nerd Font 11";
}

window {
    location:     center;
    width:        480px;
    background-color: @bg;
    border:       1px;
    border-color: @accent;
    border-radius: 0px;
    padding:      0px;
}

mainbox {
    background-color: @bg;
    children: [ inputbar, listview ];
    spacing: 0px;
    padding: 0px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 12px 14px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: @accent2;
    background-color: transparent;
}

entry {
    text-color: @fg;
    background-color: transparent;
    placeholder: "buscar...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: @bg;
    lines: 8;
    columns: 1;
    spacing: 2px;
    padding: 6px 0px;
    fixed-height: false;
    scrollbar: false;
    border: 0px;
}

element {
    background-color: transparent;
    text-color: @fg-dim;
    padding: 8px 14px;
    border-radius: 0px;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent2;
    border: 0px 0px 0px 2px;
    border-color: @accent;
}

element-icon {
    size: 20px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    vertical-align: 0.5;
}
